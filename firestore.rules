rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function acesso() { return get(/databases/$(database)/documents/config/acesso).data; }
    function temAcesso() { return exists(/databases/$(database)/documents/config/acesso); }
    function empregador() { return logado() && temAcesso() && acesso().empregador == request.auth.uid; }
    function motorista() { return logado() && temAcesso() && request.auth.uid in acesso().motoristas; }

    // Quem manda: a primeira conta assume como empregador; depois só ela altera.
    match /config/acesso {
      allow read: if logado();
      allow create: if logado() && request.resource.data.empregador == request.auth.uid;
      allow update: if empregador() && request.resource.data.empregador == resource.data.empregador;
    }
    // Regras de cálculo, salário e pagamentos: só o empregador altera.
    match /config/he {
      allow read: if empregador() || motorista();
      allow write: if empregador();
    }
    // Lançamentos de horas extras, um documento por dia.
    match /he/{dia} {
      allow read: if empregador() || motorista();
      allow create, update: if empregador();
      allow create: if motorista() && request.resource.data.status == 'pendente';
      allow update: if motorista() && (
        (resource.data.status == 'pendente' && request.resource.data.status == 'pendente') ||
        (resource.data.get('anulado', false) == true && request.resource.data.status == 'pendente') ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pedido', 'hist'])
      );
      allow delete: if false;
    }
    // Pedidos de acesso de novas contas.
    match /pedidos/{uid} {
      allow read, create, update: if logado() && request.auth.uid == uid;
      allow read, delete: if empregador();
    }
  }
}
